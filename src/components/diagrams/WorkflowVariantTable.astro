---
// WorkflowVariantTable — 2-column comparison table
// Government / Scheme Payer (Oncology) vs Commercial Insurer (Elective Surgery)
// Shows 5 rows of workflow differences — generic, global framing
---

<div class="wvt-wrap">
  <div class="wvt-table-scroll">
    <table class="wvt-table">
      <thead>
        <tr>
          <th class="wvt-th wvt-th--label" scope="col">Dimension</th>
          <th class="wvt-th wvt-th--col1" scope="col">
            <div class="wvt-col-header">
              <span class="wvt-col-badge">Government / Scheme Payer</span>
              <span class="wvt-col-name">Oncology — Multi-cycle Treatment</span>
            </div>
          </th>
          <th class="wvt-th wvt-th--col2" scope="col">
            <div class="wvt-col-header">
              <span class="wvt-col-badge wvt-col-badge--alt">Commercial Insurer</span>
              <span class="wvt-col-name">Elective Surgery — Single Episode</span>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr class="wvt-row wvt-row--alt">
          <td class="wvt-td wvt-td--label">Authorisation requirement</td>
          <td class="wvt-td">Multi-disciplinary team certification required before approval</td>
          <td class="wvt-td">Standard pre-authorisation against policy schedule</td>
        </tr>
        <tr class="wvt-row">
          <td class="wvt-td wvt-td--label">Coding standard</td>
          <td class="wvt-td">Scheme-defined procedure package codes with strict bundling rules</td>
          <td class="wvt-td">ICD-10 / CPT codes aligned to insurer policy terms</td>
        </tr>
        <tr class="wvt-row wvt-row--alt">
          <td class="wvt-td wvt-td--label">Submission channel</td>
          <td class="wvt-td">Government payer portal with scheme-specific data format</td>
          <td class="wvt-td">Insurer portal, intermediary gateway, or EDI</td>
        </tr>
        <tr class="wvt-row">
          <td class="wvt-td wvt-td--label">Episode structure</td>
          <td class="wvt-td">Multi-cycle with reauthorisation required at each cycle</td>
          <td class="wvt-td">Single episode, single claim</td>
        </tr>
        <tr class="wvt-row wvt-row--alt">
          <td class="wvt-td wvt-td--label">Documentation checklist</td>
          <td class="wvt-td">Scheme-mandated documentation set, strictly enforced</td>
          <td class="wvt-td">Insurer-specific checklist, variable by policy</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="wvt-caption">
    Two claims. Same hospital. Completely different workflows.
  </p>
</div>

<style>
  .wvt-wrap {
    width: 100%;
  }

  /* Scrollable container for narrow screens */
  .wvt-table-scroll {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--border-default);
  }

  .wvt-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
    background: var(--card-bg);
  }

  /* ─── Header row ─── */
  .wvt-th {
    padding: 1rem 1.125rem;
    text-align: left;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-default);
    vertical-align: middle;
  }

  .wvt-th--label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    width: 22%;
  }

  .wvt-th--col1,
  .wvt-th--col2 {
    width: 39%;
  }

  .wvt-col-header {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .wvt-col-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--domain-finops-muted);
    color: var(--domain-finops);
    border: 1px solid var(--domain-finops-border);
    width: fit-content;
  }

  .wvt-col-badge--alt {
    background: var(--bg-highlight);
    color: var(--text-secondary);
    border-color: var(--border-default);
  }

  .wvt-col-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  /* ─── Body rows ─── */
  .wvt-row:not(:last-child) td {
    border-bottom: 1px solid var(--border-subtle);
  }

  .wvt-row--alt {
    background: var(--bg-card);
  }

  .wvt-td {
    padding: 0.875rem 1.125rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    vertical-align: top;
  }

  .wvt-td--label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  /* ─── Caption ─── */
  .wvt-caption {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
    text-align: center;
    margin-top: 1rem;
    line-height: 1.5;
  }
</style>
