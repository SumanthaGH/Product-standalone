---
// PayerIntelligenceFlow — monitoring flow visual for Payer Rule Intelligence
// 3 sources → central agent box → 2 outputs
// Domain: FinOps amber
---

<div class="pif-wrap">

  <!-- Top row: 3 source nodes -->
  <div class="pif-sources">
    <div class="pif-source-node">
      <div class="pif-source-icon" aria-hidden="true">
        <!-- globe / payer portal -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
      </div>
      <span class="pif-source-label">Payer Portal</span>
    </div>

    <div class="pif-source-connector" aria-hidden="true"></div>

    <div class="pif-source-node pif-source-node--mid">
      <div class="pif-source-icon" aria-hidden="true">
        <!-- file-text / scheme bulletins -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
      </div>
      <span class="pif-source-label">Scheme Bulletins</span>
    </div>

    <div class="pif-source-connector" aria-hidden="true"></div>

    <div class="pif-source-node">
      <div class="pif-source-icon" aria-hidden="true">
        <!-- bell / TPA notices -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
      </div>
      <span class="pif-source-label">Payer Notices</span>
    </div>
  </div>

  <!-- Down arrows from sources to central box -->
  <div class="pif-arrows-down" aria-hidden="true">
    <div class="pif-arrow-down"></div>
    <div class="pif-arrow-down pif-arrow-down--mid"></div>
    <div class="pif-arrow-down"></div>
  </div>

  <!-- Central agent box -->
  <div class="pif-agent-box">
    <div class="pif-agent-header">
      <span class="pif-agent-icon" aria-hidden="true">
        <!-- bot icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M12 8V4H8"/>
          <rect width="16" height="12" x="4" y="8" rx="2"/>
          <path d="M2 14h2"/>
          <path d="M20 14h2"/>
          <path d="M15 13v2"/>
          <path d="M9 13v2"/>
        </svg>
      </span>
      <span class="pif-agent-name">Payer Rule Intelligence Agent</span>
    </div>
    <div class="pif-agent-logic">
      <div class="pif-logic-step">
        <span class="pif-logic-bullet" aria-hidden="true">→</span>
        Detects change in payer publication
      </div>
      <div class="pif-logic-step">
        <span class="pif-logic-bullet" aria-hidden="true">→</span>
        Parses operational delta
      </div>
      <div class="pif-logic-step">
        <span class="pif-logic-bullet" aria-hidden="true">→</span>
        Flags for human review
      </div>
      <div class="pif-logic-step pif-logic-step--alt">
        <span class="pif-logic-bullet" aria-hidden="true">→</span>
        Auto-applies if unambiguous &amp; low-impact (human confirmation required)
      </div>
    </div>
  </div>

  <!-- Down arrows from agent to outputs -->
  <div class="pif-arrows-down pif-arrows-down--narrow" aria-hidden="true">
    <div class="pif-arrow-down"></div>
    <div class="pif-arrow-down pif-arrow-down--wide"></div>
  </div>

  <!-- Bottom row: 2 output nodes -->
  <div class="pif-outputs">
    <div class="pif-output-node">
      <div class="pif-output-icon" aria-hidden="true">
        <!-- users icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </div>
      <span class="pif-output-label">Claims team alert</span>
      <span class="pif-output-sub">Structured update for review</span>
    </div>

    <div class="pif-output-node">
      <div class="pif-output-icon" aria-hidden="true">
        <!-- settings / gear icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
      </div>
      <span class="pif-output-label">Agent config updated</span>
      <span class="pif-output-sub">After human confirmation</span>
    </div>
  </div>

</div>

<style>
  /* ─── Wrapper ─── */
  .pif-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    max-width: 640px;
    margin: 0 auto;
  }

  /* ─── Source row ─── */
  .pif-sources {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 100%;
  }

  .pif-source-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    background: var(--diagram-bg);
    border: 1px solid var(--diagram-border);
    border-radius: 8px;
    min-width: 120px;
    text-align: center;
    flex-shrink: 0;
  }

  .pif-source-node--mid {
    background: var(--domain-finops-muted);
    border-color: var(--domain-finops-border);
  }

  .pif-source-connector {
    flex: 1;
    height: 1px;
    background: var(--domain-finops-border);
    max-width: 48px;
  }

  .pif-source-icon {
    color: var(--domain-finops);
  }

  .pif-source-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  /* ─── Down arrows ─── */
  .pif-arrows-down {
    display: flex;
    align-items: flex-start;
    justify-content: space-around;
    width: 88%;
    padding: 0;
  }

  .pif-arrows-down--narrow {
    width: 55%;
  }

  .pif-arrow-down {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .pif-arrow-down::before {
    content: '';
    width: 1px;
    height: 20px;
    background: var(--domain-finops-border);
    display: block;
  }

  .pif-arrow-down::after {
    content: '';
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid var(--domain-finops);
    display: block;
  }

  /* ─── Central agent box ─── */
  .pif-agent-box {
    width: 100%;
    background: var(--diagram-bg);
    border: 1px solid var(--domain-finops-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 0 0 4px var(--domain-finops-muted);
  }

  .pif-agent-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--domain-finops-border);
  }

  .pif-agent-icon {
    color: var(--domain-finops);
    flex-shrink: 0;
  }

  .pif-agent-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--domain-finops);
    line-height: 1.3;
  }

  .pif-agent-logic {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .pif-logic-step {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .pif-logic-bullet {
    color: var(--domain-finops);
    font-weight: 700;
    flex-shrink: 0;
  }

  .pif-logic-step--alt {
    background: var(--domain-finops-muted);
    border: 1px solid var(--domain-finops-border);
    border-radius: 6px;
    padding: 0.375rem 0.625rem;
    margin-top: 0.25rem;
  }

  /* ─── Output row ─── */
  .pif-outputs {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .pif-output-node {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    background: var(--diagram-bg);
    border: 1px solid var(--diagram-border);
    border-top: 2px solid var(--domain-finops);
    border-radius: 8px;
    text-align: center;
  }

  .pif-output-icon {
    color: var(--domain-finops);
    margin-bottom: 0.125rem;
  }

  .pif-output-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .pif-output-sub {
    font-size: 10px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ─── Mobile ─── */
  @media (max-width: 560px) {
    .pif-source-node {
      min-width: 80px;
      padding: 0.5rem 0.625rem;
    }

    .pif-source-label {
      font-size: 11px;
    }

    .pif-arrows-down--narrow {
      width: 70%;
    }
  }
</style>
