---
// Platform-page HITL Spectrum — 3 zones with full activity lists from content_plan.md §3
// Distinct from HumanInTheLoop.astro (homepage), which has callout cards below.
// This version is more detailed and is used only on the Platform page.
---

<div class="hitl-spectrum">

  <div class="spectrum-bar">

    <div class="zone zone-a">
      <div class="zone-header">
        <span class="zone-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round">
            <rect width="16" height="16" x="4" y="4" rx="2"/>
            <rect width="6" height="6" x="9" y="9" rx="1"/>
            <path d="M15 2v2M15 20v2M2 15h2M20 15h2M2 9h2M20 9h2M9 2v2M9 20v2"/>
          </svg>
        </span>
        <h4 class="zone-title">Agent Autonomous</h4>
      </div>
      <p class="zone-sub">Low stakes, high volume — no human needed per event</p>
      <ul class="zone-list">
        <li>Continuous KPI monitoring</li>
        <li>Pattern detection</li>
        <li>Routine alerting</li>
        <li>Scheduling reminders</li>
        <li>Feedback routing</li>
        <li>Data quality monitoring</li>
      </ul>
    </div>

    <div class="zone-divider" aria-hidden="true"></div>

    <div class="zone zone-b">
      <div class="zone-header">
        <span class="zone-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <polyline points="16 11 18 13 22 9"/>
          </svg>
        </span>
        <h4 class="zone-title">Agent + Human</h4>
      </div>
      <p class="zone-sub">Agent does the work; human validates the decision</p>
      <ul class="zone-list">
        <li>Ambiguous guideline interpretation</li>
        <li>High-impact config changes</li>
        <li>Novel failure modes</li>
        <li>Clinical content for communications</li>
        <li>Write-off approvals above threshold</li>
        <li>Appeal package approval</li>
      </ul>
      <p class="zone-time">~15–40 min human time per occurrence</p>
    </div>

    <div class="zone-divider" aria-hidden="true"></div>

    <div class="zone zone-c">
      <div class="zone-header">
        <span class="zone-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M20 7h-9"/>
            <path d="M14 17H5"/>
            <circle cx="17" cy="17" r="3"/>
            <circle cx="7" cy="7" r="3"/>
          </svg>
        </span>
        <h4 class="zone-title">Human Leads</h4>
      </div>
      <p class="zone-sub">Agent prepares; human decides and acts</p>
      <ul class="zone-list">
        <li>Payer relationship negotiation</li>
        <li>Automation roadmap strategy</li>
        <li>Process redesign</li>
        <li>Staff adoption &amp; change management</li>
        <li>Accountability for consequential errors</li>
      </ul>
    </div>

  </div>

  <!-- Gradient indicator -->
  <div class="gradient-indicator" aria-hidden="true">
    <span class="gi-label">Lower stakes, higher volume</span>
    <div class="gi-bar"></div>
    <span class="gi-label">Higher stakes, human judgment</span>
  </div>

</div>

<style>
  .hitl-spectrum {
    width: 100%;
  }

  .spectrum-bar {
    display: flex;
    background: var(--hitl-gradient);
    border: 1px solid var(--border-default);
    border-radius: 1rem;
    overflow: hidden;
  }

  .zone {
    flex: 1;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .zone-a { background: var(--hitl-zone-a-bg); }
  .zone-b { background: var(--hitl-zone-b-bg); }
  .zone-c { background: var(--hitl-zone-c-bg); }

  .zone-divider {
    width: 1px;
    background: var(--border-subtle);
    flex-shrink: 0;
  }

  .zone-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .zone-icon {
    color: var(--text-primary);
    opacity: 0.6;
    display: flex;
    flex-shrink: 0;
  }

  .zone-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .zone-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
  }

  .zone-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .zone-list li {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
    padding-left: 0.875rem;
    position: relative;
  }

  .zone-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  .zone-time {
    font-size: 10px;
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
    line-height: 1.4;
  }

  /* Gradient indicator */
  .gradient-indicator {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.875rem;
    padding: 0 0.25rem;
  }

  .gi-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .gi-bar {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--border-subtle) 0%, var(--border-strong) 100%);
    border-radius: 9999px;
  }

  /* Mobile: stack zones vertically */
  @media (max-width: 768px) {
    .spectrum-bar {
      flex-direction: column;
    }

    .zone-divider {
      width: auto;
      height: 1px;
    }

    .gradient-indicator {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .gi-bar {
      width: 100%;
    }
  }
</style>
