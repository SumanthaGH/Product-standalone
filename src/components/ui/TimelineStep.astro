---
// TimelineStep — reusable horizontal timeline step
// Used in: CX Blueprint, FinOps lifecycle
interface Props {
  stepNumber: number | string;
  label: string;
  description?: string;
  icon?: string; // Lucide icon name, rendered inline as SVG
  isLast?: boolean;
  domainColor?: string; // CSS var e.g. '--domain-cx'
}

const {
  stepNumber,
  label,
  description,
  isLast = false,
  domainColor = '--domain-cx',
} = Astro.props;

const dotColor = `var(${domainColor})`;
const dotMuted = `var(${domainColor}-muted)`;
const dotBorder = `var(${domainColor}-border)`;
---

<div class={`timeline-step ${isLast ? 'timeline-step--last' : ''}`}>
  <!-- Step connector line (hidden on last) -->
  {!isLast && <div class="step-connector" aria-hidden="true"></div>}

  <!-- Step content -->
  <div class="step-body">
    <!-- Number dot with optional icon slot -->
    <div class="step-dot" style={`background: ${dotMuted}; border-color: ${dotBorder}; color: ${dotColor};`} aria-hidden="true">
      <slot name="icon">
        <span class="step-num">{stepNumber}</span>
      </slot>
    </div>

    <div class="step-text">
      <div class="step-label">{label}</div>
      {description && <p class="step-desc">{description}</p>}
    </div>
  </div>
</div>

<style>
  .timeline-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    min-width: 0;
  }

  /* Horizontal connector line */
  .step-connector {
    position: absolute;
    top: 18px; /* centre of dot */
    left: calc(50% + 18px);
    right: calc(-50% + 18px);
    height: 1px;
    background: var(--timeline-line);
    z-index: 0;
  }

  .step-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    position: relative;
    z-index: 1;
    width: 100%;
    text-align: center;
  }

  .step-dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-num {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 0.25rem;
  }

  .step-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .step-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* Mobile: vertical stack */
  @media (max-width: 640px) {
    .timeline-step {
      flex-direction: row;
      align-items: flex-start;
      flex: none;
      width: 100%;
    }

    .step-connector {
      /* Vertical connector on mobile */
      top: calc(18px + 0.625rem);
      left: 17px;
      right: auto;
      width: 1px;
      height: calc(100% - 36px);
    }

    .step-body {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
    }

    .step-text {
      padding: 0.125rem 0 0;
    }
  }
</style>
