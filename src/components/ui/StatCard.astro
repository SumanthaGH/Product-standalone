---
interface Props {
  value: string;
  label: string;
  domainColor?: string; // CSS var name e.g. '--domain-cx'
  class?: string;
}

const { value, label, domainColor, class: className = '' } = Astro.props;

const valueStyle = domainColor ? `color: var(${domainColor})` : '';
---

<div class={`stat-card ${className}`}>
  <div class="stat-value" style={valueStyle}>{value}</div>
  <div class="stat-label">{label}</div>
</div>

<style>
  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    box-shadow: var(--card-shadow);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .stat-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  .stat-value {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--stat-val-color);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.4;
  }
</style>
